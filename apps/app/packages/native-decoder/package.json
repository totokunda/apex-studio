{
  "name": "@app/native-decoder",
  "version": "1.0.0",
  "private": true,
  "main": "build/Release/native_decoder.node",
  "scripts": {
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.js",
    "fetch:ffmpeg:arm64": "FFMPEG_ARCH=arm64 node scripts/fetch-ffmpeg.js",
    "fetch:ffmpeg:x64": "FFMPEG_ARCH=x64 node scripts/fetch-ffmpeg.js",
    "install": "npm run fetch:ffmpeg && cmake-js compile -r electron -v 38.1.2",
    "prebuild": "npm run fetch:ffmpeg",
    "build": "cmake-js build -r electron -v 38.1.2",
    "build:mac:arm64": "npm run fetch:ffmpeg:arm64 && cmake-js rebuild -r electron -v 38.1.2 -a arm64",
    "build:mac:x64": "npm run fetch:ffmpeg:x64 && cmake-js rebuild -r electron -v 38.1.2 -a x64",
    "build:debug": "cmake-js build -r electron -v 38.1.2 -D",
    "rebuild": "cmake-js rebuild -r electron -v 38.1.2",
    "clean": "cmake-js clean",
    "test": "electron --no-sandbox test/test-addon.mjs"
  },
  "dependencies": {
    "cmake-js": "^7.3.0",
    "node-addon-api": "^8.3.0"
  }
}
